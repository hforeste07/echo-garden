<!-- Hero Section -->
<!-- Hero Section -->
<section class="text-center">
  <!-- Top Image -->
  <div style="background-image: url('<%= asset_path('landing_page/nativegardenCA.jpg') %>'); 
              background-size: cover; 
              background-position: center; 
              height: 400px; 
              width: 100%;">
  </div>

  <!-- Text & CTA -->
  <div class="bg-theme-light text-theme-primary py-5">
    <div class="container">
      <h1 class="display-4 fw-bold">Grow A Native Garden with Ease</h1>
      <p class="lead mb-4">Plan, track, and optimize your garden plots and plants — all in one app.</p>
      <%= link_to "Get Started", new_user_registration_path, class: "btn btn-primary btn-lg" %>
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-5">
  <div class="container">
    <h2 class="text-center mb-5 text-theme-primary">Key Features</h2>
    <div class="row text-center g-3 justify-content-center">
      <div class="col-md-4">
        <i class="bi bi-grid-1x2-fill display-4 text-theme-primary mb-3"></i>
        <h3>Plan Your Garden</h3>
        <p>Create and organize plots visually with intuitive tools.</p>
      </div>
      <div class="col-md-4">
        <i class="bi bi-grid-1x2-fill display-4 text-theme-primary mb-3"></i>
        <h3>Create Multiple Gardens</h3>
        <p>Create and manage multiple garden spaces in one place.</p>
      </div>
    </div>
  </div>
</section>

