<!-- Testimonials Section -->
<section class="py-5">
  <div class="container text-center">
    <h2 class="mb-5 text-theme-primary">What Our Users Say</h2>
    <div class="row g-4 justify-content-center">
      <div class="col-md-4">
        <blockquote class="blockquote">
          <p>"EchoGarden transformed the way I manage my backyard garden. Highly recommend!"</p>
          <footer class="blockquote-footer">Jane D.</footer>
        </blockquote>
      </div>
      <div class="col-md-4">
        <blockquote class="blockquote">
          <p>"Perfect for hobby gardeners looking to track their plants efficiently."</p>
          <footer class="blockquote-footer">John D.</footer>
        </blockquote>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="text-center py-5 bg-theme-primary text-theme-secondary">
  <div class="container">
    <h2 class="mb-4">Ready to Grow Your Garden?</h2>
    <%= link_to "Get Started Now", new_user_registration_path, class: "btn btn-secondary btn-lg" %>
  </div>
</section>
